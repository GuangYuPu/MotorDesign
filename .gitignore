# 临时与系统文件
*.tmp
~$*
Thumbs.db
desktop.ini
.DS_Store

# 大体积附件（照片/视频/CAD）建议单独管理或使用 Git LFS
# 若已配置 Git LFS，可删除下面五行
附件/**/*.mp4
附件/**/*.step
附件/**/*.stp
附件/**/*.SLDPRT
附件/**/*.prt

# Obsidian 本机状态（每次打开都会变，提交只会产生噪音）
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# 本机生成的 SSH known_hosts（推送用，不进仓库）
.git-ssh-known_hosts
